PORT=3000
NODE_ENV="production"
DATABASE_URL="postgresql://user:password@host:5432/angelmate?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret-min-32-chars"

# Email / SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_NAME="AngelMate"
SMTP_FROM_EMAIL="noreply@angelmate.com"

# AI (optional, for fish identification)
GOOGLE_API_KEY="your-google-generative-ai-key"

# Frontend (for CORS, etc)
VITE_API_URL="https://your-domain.com/api"
